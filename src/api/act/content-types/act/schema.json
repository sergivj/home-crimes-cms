{
  "kind": "collectionType",
  "collectionName": "acts",
  "info": {
    "singularName": "act",
    "pluralName": "acts",
    "displayName": "Act"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "unlockType": {
      "type": "enumeration",
      "enum": [
        "auto",
        "code",
        "answer",
        "fileSolved"
      ],
      "default": "auto",
      "required": true
    },
    "unlockCode": {
      "type": "string"
    },
    "videoUrl": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "isFinalStep": {
      "type": "boolean",
      "default": false
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "inversedBy": "acts",
      "required": true
    },
    "clues": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::clue.clue",
      "mappedBy": "act"
    }
  }
}
