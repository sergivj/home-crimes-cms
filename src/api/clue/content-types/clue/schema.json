{
  "kind": "collectionType",
  "collectionName": "clues",
  "info": {
    "singularName": "clue",
    "pluralName": "clues",
    "displayName": "Clue"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "text",
        "pdf",
        "image",
        "audio",
        "video",
        "code",
        "puzzle",
        "qr"
      ],
      "required": true
    },
    "content": {
      "type": "richtext"
    },
    "file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files",
        "images",
        "videos",
        "audios"
      ]
    },
    "order": {
      "type": "integer",
      "required": true
    },
    "solution": {
      "type": "string"
    },
    "previewImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "act": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::act.act",
      "inversedBy": "clues",
      "required": true
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product"
    }
  }
}
