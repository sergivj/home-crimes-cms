{
  "kind": "collectionType",
  "collectionName": "families",
  "info": {
    "singularName": "family",
    "pluralName": "families",
    "displayName": "Family"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "hotel",
        "granary",
        "church",
        "police"
      ]
    },
    "description": {
      "type": "richtext"
    },
    "case": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::case.case",
      "inversedBy": "families",
      "required": true
    },
    "characters": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::character.character",
      "mappedBy": "family"
    },
    "evidence": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::evidence.evidence",
      "mappedBy": "families"
    }
  }
}
