{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "confirmation_id": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "inversedBy": "orders",
      "required": true
    },
    "emailSended": {
      "type": "boolean",
      "default": false
    },
    "email": {
      "type": "email",
      "required": true
    }
  }
}
