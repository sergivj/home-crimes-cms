{
  "kind": "collectionType",
  "collectionName": "locations",
  "info": {
    "singularName": "location",
    "pluralName": "locations",
    "displayName": "Location"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "code": {
      "type": "string"
    },
    "description": {
      "type": "richtext"
    },
    "mapPosition": {
      "type": "component",
      "repeatable": false,
      "component": "location.map-position"
    },
    "isLocked": {
      "type": "boolean",
      "default": false
    },
    "lockReason": {
      "type": "text"
    },
    "case": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::case.case",
      "inversedBy": "locations",
      "required": true
    },
    "evidence": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::evidence.evidence",
      "mappedBy": "locations"
    },
    "events": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::event.event",
      "mappedBy": "locations"
    }
  }
}
