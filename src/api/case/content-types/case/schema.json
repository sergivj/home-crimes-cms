{
  "kind": "collectionType",
  "collectionName": "cases",
  "info": {
    "singularName": "case",
    "pluralName": "cases",
    "displayName": "Case"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
