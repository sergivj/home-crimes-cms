    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "briefing": {
      "type": "richtext"
    },
    "disclaimer": {
      "type": "text"
    },
    "currentObjectiveTemplate": {
      "type": "text"
    },
    "theme": {
      "type": "enumeration",
      "enum": [
        "police-file",
        "dark"
      ]
    },
    "events": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event.event",
      "mappedBy": "case"
    },
    "families": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::family.family",
      "mappedBy": "case"
    },
    "characters": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::character.character",
      "mappedBy": "case"
    },
    "locations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::location.location",
      "mappedBy": "case"
    },
    "evidence": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::evidence.evidence",
      "mappedBy": "case"
    },
    "questions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::question.question",
      "mappedBy": "case"
    }
  }
